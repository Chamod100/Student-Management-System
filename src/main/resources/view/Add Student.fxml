<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="750.0" style="-fx-background-color: #f9fbff;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AddStudentController">
    <HBox alignment="CENTER_LEFT" prefHeight="60" style="-fx-background-color: #1e2a78;"><Label prefHeight="30.0" prefWidth="758.0" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;" text="   Add Customer" />
    </HBox>

    <VBox layoutX="150" layoutY="120" spacing="20">
        <HBox spacing="15"><Label prefWidth="120" text="Student ID" /><TextField fx:id="txtStudentId" prefWidth="300" /></HBox>
        <HBox spacing="15"><Label prefWidth="120" text="Name" /><TextField fx:id="txtName" prefWidth="300" /></HBox>
        <HBox spacing="15"><Label prefWidth="120" text="NIC" /><TextField fx:id="txtNic" prefWidth="300" /></HBox>
        <HBox spacing="15"><Label prefWidth="120" text="Phone" /><TextField fx:id="txtPhone" prefWidth="300" /></HBox>
        <HBox spacing="15"><Label prefWidth="120" text="Email" /><TextField fx:id="txtEmail" prefWidth="300" /></HBox>
    </VBox>
    <HBox layoutX="250" layoutY="400" spacing="20"><Button onAction="#handleCancel" prefWidth="120" style="-fx-background-color: #c0c0c0; -fx-font-weight: bold;" text="CANCEL" />
        <Button onAction="#handleAddStudent" prefWidth="150" style="-fx-background-color: #1e2a78; -fx-text-fill: white; -fx-font-weight: bold;" text="ADD Student" />
    </HBox>
   <HBox alignment="CENTER_LEFT" layoutY="440.0" prefHeight="60" style="-fx-background-color: #1e2a78;">
      <children>
         <Label prefHeight="30.0" prefWidth="758.0" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;" text="   Add Customer" />
      </children>
   </HBox>
</AnchorPane>
